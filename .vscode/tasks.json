{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DreeRally: build Debug",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Build.ps1",
        "-Configuration",
        "Debug"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "DreeRally: build Release",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Build.ps1",
        "-Configuration",
        "Release"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "DreeRally: check assets",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Check-Assets.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "DreeRally: prepare Debug",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/Prepare-Runtime.ps1",
        "-Configuration",
        "Debug"
      ],
      "dependsOn": [
        "DreeRally: build Debug"
      ],
      "problemMatcher": []
    }
  ]
}
