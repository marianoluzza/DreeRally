{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DreeRally: Windows Debug",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/runtime/DreeRally.exe",
      "args": [
        "-window"
      ],
      "cwd": "${workspaceFolder}/runtime",
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "preLaunchTask": "DreeRally: prepare Debug"
    }
  ]
}
